# Copy to .env.local and edit for your machine.

OPENCLAW_HOME=$HOME/.openclaw
NOTEBOOKLM_HOME=$HOME/.openclaw/skills/nblm/data/auth
NBLM_BIN=$HOME/.openclaw/skills/nblm/.venv/bin/notebooklm

NOTEBOOK_ID_HARDTHING=01f1afb7-32da-485f-bf68-b0bb2b8e6bef
FEISHU_TARGET_OPEN_ID=ou_c9b4c3ce366fdd14fb473381206148e8

# Optional (set if you want direct Feishu file API instead of openclaw --media)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

XHS_MCP_BASE=http://localhost:18060
XHS_LOG_DIR=./state/runtime/xhs_logs
LEGACY_XHS_GLOB=./resources/samples/xhs/latest/xhs_books_analysis_*.json

OUTPUT_ROOT=./state/runtime/outputs/hard-thing-series
PLAYWRIGHT_NODE_MODULES=./node_modules
OPENCLAW_BROWSER_PROFILE_DIR=$HOME/.openclaw/browser/openclaw/user-data
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
