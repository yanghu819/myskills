{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "book_outline.v1",
  "type": "object",
  "required": ["book_meta", "chapters"],
  "additionalProperties": false,
  "properties": {
    "book_meta": {
      "type": "object",
      "required": ["title", "author", "language"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "enum": ["zh"]
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "core_thesis",
          "key_points",
          "evidence_or_case",
          "quote",
          "action_items"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "core_thesis": {
            "type": "string",
            "minLength": 1
          },
          "key_points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_or_case": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "action_items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
