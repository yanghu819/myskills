{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "render_manifest.v1",
  "type": "object",
  "required": ["width", "height", "card_count", "images", "generated_at"],
  "additionalProperties": false,
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "card_count": {
      "type": "integer",
      "minimum": 1
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
